    given-names: Florian
    orcid: "https://orcid.org/0000-0000-0000-0000"  # TODO: insert ORCID
license: MIT
version: "0.2.0"
date-released: "2026-09-04"
repository-code: "https://github.com/FDOx-squirrel/fdo-squirrel-spec"
keywords:
